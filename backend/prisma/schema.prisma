generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  googleId      String?        @unique
  avatarUrl     String?
  fullName      String
  phoneNumber   String?        @unique
  role          Role           @default(BUYER)
  isVerified    Boolean        @default(false)
  isBanned      Boolean        @default(false)
  tokenVersion  Int            @default(0)
  resetCode     String?
  resetCodeExpiresAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     Favorite[]
  listings      Listing[]
  messagesRecv  Message[]      @relation("ReceivedMessages")
  messagesSent  Message[]      @relation("SentMessages")
  notifications Notification[]
  offers        Offer[]
  reports       Report[]
  auditLogs     AuditLog[]     @relation("AuditLogsTarget")
  auditLogsDone AuditLog[]     @relation("AuditLogsActor")
  aiUsageLogs   AiUsageLog[]
}

model Listing {
  id              String           @id @default(uuid())
  title           String
  description     String?
  whatsappNumber  String?
  category        ListingCategory
  listingType     ListingType
  status          ListingStatus    @default(ACTIVE)
  price           Float
  rentPeriod      RentPeriod?
  city            String
  district        String
  latitude        Float?
  longitude       Float?
  images          String[]
  views           Int              @default(0)
  aiMetadata      Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sellerId        String
  carDetails      CarDetails?
  favorites       Favorite[]
  seller          User             @relation(fields: [sellerId], references: [id])
  messages        Message[]
  offers          Offer[]
  propertyDetails PropertyDetails?
  reports         Report[]

  @@index([category, listingType])
  @@index([city, district])
  @@index([price])
  @@index([sellerId])
  @@index([status, category, listingType])
  @@index([status, city])
}

model PropertyDetails {
  id           String   @id @default(uuid())
  propertyType String
  area         Float
  bedrooms     Int?
  bathrooms    Int?
  floor        Int?
  yearBuilt    Int?
  amenities    String[]
  listingId    String   @unique
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([bedrooms, bathrooms])
  @@index([propertyType, area])
}

model CarDetails {
  id           String  @id @default(uuid())
  brand        String
  model        String
  year         Int
  mileage      Float?
  fuelType     String
  transmission String
  condition    String
  listingId    String  @unique
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([brand, model])
  @@index([condition, year])
}

model Offer {
  id        String      @id @default(uuid())
  amount    Float
  status    OfferStatus @default(PENDING)
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  buyerId   String
  listingId String
  buyer     User        @relation(fields: [buyerId], references: [id])
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  senderId   String
  receiverId String
  listingId  String?
  imageUrl   String?
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([listingId])
  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType @default(INFO)
  content   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Report {
  id        String       @id @default(uuid())
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  createdAt DateTime @default(now())
  
  targetUserId String?
  targetUser   User?    @relation("AuditLogsTarget", fields: [targetUserId], references: [id])
  
  actorId   String?
  actor     User?    @relation("AuditLogsActor", fields: [actorId], references: [id])

  @@index([targetUserId])
  @@index([actorId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum ListingCategory {
  REAL_ESTATE
  CAR
}

enum ListingType {
  SALE
  RENT
}

enum RentPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ListingStatus {
  ACTIVE
  SOLD
  RENTED
  PENDING_REVIEW
  EXPIRED
  DELETED
  REPORTED
  REJECTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationType {
  INFO
  ALERT
  OFFER_RECEIVED
  MESSAGE_RECEIVED
  SYSTEM
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

model AiUsageLog {
  id            String   @id @default(uuid())
  feature       String
  status        String   // 'SUCCESS' or 'FAILED'
  tokensUsed    Int      @default(0)
  estimatedCost Float    @default(0.0)
  createdAt     DateTime @default(now())
  
  userId        String
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
